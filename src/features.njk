    <tr><th scope="row">Search, recorded expiration dates & Expiring view</th><td>Included</td><td>Included</td></tr>
    <tr><th scope="row">Expiration reminders</th><td>Three days before expiry</td><td>Up to two configurable times</td></tr>
    <tr><th scope="row">Personal iCloud sync, view History & widget</th><td>Included</td><td>Included</td></tr>
    <tr><th scope="row">Household sharing</th><td>Requires Pro</td><td>Included</td></tr>
    <tr><th scope="row">Add Again from History</th><td>Requires Pro</td><td>Included</td></tr>
  </tbody></table></div><p class="fine-print">Finished items do not count toward the 75-active-item free limit.</p></section>
